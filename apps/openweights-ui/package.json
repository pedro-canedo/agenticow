{
  "name": "@openweights/agenticow-ui",
  "version": "0.1.0",
  "private": true,
  "description": "AgenticOw no navegador: marca (barra lateral, conversa vazia, título) e o idioma pt-BR sobre a UI do upstream.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "client.js"
  ],
  "scripts": {
    "gerar": "node scripts/gerar-cliente.mjs",
    "cobertura": "node scripts/cobertura.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
